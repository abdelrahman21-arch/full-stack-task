    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.44.5",
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.12",
    "tsx": "4.20.3"
