{
  "name": "referral-monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "predev": "pnpm --filter @repo/schemas --filter @repo/types --filter @repo/utils build",
    "dev": "pnpm -r --parallel --filter @repo/schemas --filter @repo/types --filter @repo/utils --filter @repo/web --filter @repo/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "turbo": "2.0.14",
    "typescript": "5.8.3"
  }
}
